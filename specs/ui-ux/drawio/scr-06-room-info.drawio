        <mxCell id="c182" value="Hai bạn sẽ không còn là bạn bè, không tìm thấy nhau qua email; lời mời giữa hai bạn bị đóng. Phòng chỉ có hai bạn chuyển sang chỉ đọc. Phòng nhóm vẫn chat bình thường. Trần An không được báo." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1349" y="348" width="287" height="150" as="geometry"/></mxCell>
