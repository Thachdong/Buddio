rules_version = '2';

// T-001 khởi điểm deny-all (ADR-03). Client chỉ ĐỌC — mỗi TBL thêm block read ở task tương ứng.
// Mọi ghi đi qua server (Admin SDK bỏ qua rules).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
