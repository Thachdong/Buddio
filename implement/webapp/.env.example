# Client (public) — local: giá trị demo cho emulator (project demo-* không cần key thật)
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-buddio.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-buddio
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-buddio.appspot.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=demo-buddio
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id
NEXT_PUBLIC_USE_EMULATORS=true

# Server (Admin SDK) — local dùng emulator, project id dạng demo-* để không chạm cloud
FIREBASE_PROJECT_ID=demo-buddio
FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=demo-buddio
FIREBASE_STORAGE_BUCKET=demo-buddio.appspot.com
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
