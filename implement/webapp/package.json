{
  "name": "webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "seed": "tsx --conditions=react-server scripts/seed/index.ts",
    "dev:age-session": "tsx --conditions=react-server scripts/dev/age-session.ts",
    "emulators": "firebase emulators:start --project demo-buddio",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --project unit",
    "test:emulator": "vitest run --project emulator",
    "test:e2e": "playwright test",
    "test": "firebase emulators:exec --project demo-buddio \"npm run test:unit && npm run test:emulator && npm run test:e2e\""
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "client-only": "0.0.1",
    "cn": "^0.5.2",
    "firebase": "12.19.0",
    "firebase-admin": "13.10.0",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.3",
    "firebase-tools": "15.36.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.1.0"
  }
}
